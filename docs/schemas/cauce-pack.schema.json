{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caucesound.app/schemas/cauce-pack-1.json",
  "title": "Manifiesto de paquete Cauce (formatVersion 1)",
  "description": "Describe un paquete de sonidos portable: mapas SFZ + muestras WAV + licencia. Lo leen el motor C++ y cualquier otro reproductor (por ejemplo un DAW web) sin depender de Android.",
  "type": "object",
  "required": ["format", "formatVersion", "id", "version", "name", "license", "licenseFile", "files", "instruments"],
  "properties": {
    "format": { "const": "cauce-pack" },
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string" },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "license": { "type": "string", "description": "Expresión SPDX (o LicenseRef-…)" },
    "licenseFile": { "type": "string" },
    "minEngine": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url", "license"],
        "properties": {
          "name": { "type": "string" }, "author": { "type": "string" }, "url": { "type": "string" },
          "version": { "type": "string" }, "license": { "type": "string" }, "retrieved": { "type": "string" }, "notes": { "type": "string" }
        }
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "family", "kind", "sfz"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
          "name": { "type": "string" },
          "family": { "type": "string" },
          "kind": { "enum": ["drumkit", "melodic"] },
          "sfz": { "type": "string" },
          "description": { "type": "string" },
          "origin": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "genres": { "type": "array", "items": { "type": "string" } },
          "laneNames": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
          "polyphony": { "type": "integer" }, "mono": { "type": "boolean" }, "glideSeconds": { "type": "number" },
          "volumeDb": { "type": "number" }, "previewKey": { "type": "integer" }, "lowKey": { "type": "integer" }, "highKey": { "type": "integer" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^:\\\\]+\\.(wav|sfz|json|txt|md)$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
