<?xml version="1.0" encoding="utf-8"?>
<!-- Los proyectos pueden ocupar mucho: no se suben a la copia en la nube de Google en la fase 1 -->
<data-extraction-rules>
    <cloud-backup><exclude domain="file" path="projects/" /></cloud-backup>
    <device-transfer><include domain="file" path="projects/" /></device-transfer>
</data-extraction-rules>
